<?xml version="1.0" encoding="utf-8"?>
<!--
  设置面板：与选台面板统一风格（深色底、绿色小标题、可聚焦行、主题绿强调色），
  不再使用系统默认的 Button / Switch，避免与整体观感割裂。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:background="@drawable/setting_panel_bg"
        android:maxHeight="462dp"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置"
                    android:textColor="#8BC34A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                style="@style/SettingSection"
                android:text="远程配置" />

            <TextView
                android:id="@+id/remote_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#8AB4F8"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="手机或电脑浏览器打开上面的地址，即可配置数据源与 EPG"
                android:textColor="#99EEEEEE"
                android:textSize="12sp" />

            <TextView
                style="@style/SettingSection"
                android:text="显示与启动" />

            <LinearLayout
                android:id="@+id/row_time"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="显示时间" />

                <TextView
                    android:id="@+id/value_time"
                    style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_boot"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="@string/title_boot_startup" />

                <TextView
                    android:id="@+id/value_boot"
                    style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_preload"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="预加载下一频道" />

                <TextView
                    android:id="@+id/value_preload"
                    style="@style/SettingValue" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="为下一个频道提前准备播放器，换台更快；少数设备可能因双解码卡顿"
                android:textColor="#99EEEEEE"
                android:textSize="12sp" />

            <TextView
                style="@style/SettingSection"
                android:text="数据源（M3U / TXT / JSON）" />

            <LinearLayout
                android:id="@+id/row_sources"
                style="@style/SettingRow"
                android:nextFocusDown="@+id/iptv_source">

                <TextView
                    style="@style/SettingLabel"
                    android:text="查看数据源" />

                <TextView
                    android:id="@+id/value_sources"
                    style="@style/SettingValue" />
            </LinearLayout>

            <EditText
                android:id="@+id/iptv_source"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/setting_input_bg"
                android:hint="留空使用默认源（3 个公开聚合源）"
                android:nextFocusDown="@+id/row_save"
                android:nextFocusUp="@+id/row_sources"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#FFEEEEEE"
                android:textColorHint="#607D8B"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/row_save"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="保存并重新加载"
                    android:textColor="#8BC34A" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_default"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="恢复默认源" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_recheck"
                style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:text="重新检测线路" />
            </LinearLayout>

            <TextView
                android:id="@+id/version_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#90A4AE"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
